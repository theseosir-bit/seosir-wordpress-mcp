# ---- WordPress destination (fixed; never set from the model) ----
WP_URL=https://wordpress.example.com
WP_USERNAME=mcp-editor
WP_APPLICATION_PASSWORD=replace-with-wordpress-application-password

# ---- MCP ----
APP_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_MCP_URL=https://mcp.example.com/mcp

# LOCAL TESTING ONLY. Never enable on a public-facing host.
# Use a random, 32+ character value: openssl rand -hex 32
DEV_BEARER_TOKEN=replace-with-random-64-hex-character-token

# ---- PRODUCTION OAuth resource server: your external IdP issues JWT access tokens ----
# APP_ENV=production
# OAUTH_ISSUER=https://auth.example.com/
# OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# OAUTH_AUDIENCE=https://mcp.example.com/mcp
# OAUTH_ALLOWED_SUB=the-unique-user-id-allowed-to-manage-this-site

# ---- Only if you want the OpenAI API chat example ----
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-6
# MCP_OAUTH_ACCESS_TOKEN=...
